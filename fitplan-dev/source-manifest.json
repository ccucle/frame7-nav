  "processingPolicy": {
    "scope": "Include all 7793 food rows from this specific SR Legacy archive. This is not every food, a current Korean food database, or a diet recommendation list.",
    "calories": "Use Energy KCAL nutrient 1008 directly. Do not substitute Energy kJ 1062 or recompute calories from 4/4/9.",
    "macronutrients": "Preserve each reported source value. Do not interpolate, fill from another food, clamp, or replace missing values with zero.",
    "unsaturatedFat": "Calculate mono + poly with Decimal only when both are present and the sum is no more than total fat + 0.1 g per 100 g. The 0.1 g threshold is an application consistency policy, not a USDA claim.",
    "roundingDifferences": "29 source rows have 0 < mono+poly-fat <= 0.1 g. Preserve their source sum exactly without clamping.",
    "sourceInconsistencies": "5 source rows exceed total fat by >0.1 g. Preserve fat/mono/poly; set derived unsat to null with unsatStatus source-inconsistent. Full original row IDs, derivation/source codes and differences appear in validationResults.",
    "missing": "518 rows lack mono or poly, making unsat unknown. Together with 5 inconsistent rows, 523 rows have unsat null.",
    "translation": "Join every curated translation by exact FDC ID and exact English description. Preserve raw/cooked, skin, salt, enrichment, milkfat and preparation distinctions. Broad aliases never replace these descriptions.",
    "productLabels": "Generic USDA foods are not substituted for a specific packaged product label; users may record products separately.",
    "portion": "100 g is a calculation basis, not a recommended serving."
  },
  "reproduction": {
    "build": "python fitplan-dev/build-catalog.py --archive /path/to/FoodData_Central_sr_legacy_food_csv_2018-04.zip",
