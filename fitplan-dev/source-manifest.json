  "fieldContract": {
    "id": "usda-sr- followed by official FDC ID; stable catalogue key.",
    "fdcId": "Official integer fdc_id from food.csv.",
    "ndbNumber": "NDB_number exactly as distributed in sr_legacy_food.csv, kept as a string.",
    "nameEn": "Unchanged official English food description.",
    "nameKo": "Reviewed service translation for exactly 80 selected rows; null otherwise. Not an official USDA Korean translation.",
    "aliases": "Korean search keywords only; not a guarantee of product equivalence. The full English description and preparation qualifiers remain authoritative.",
    "category": "Unchanged official food_category.csv description.",
    "per100g": "Amount per 100 g edible portion. kcal is KCAL; protein, carbs, fat, mono, poly, unsat are grams.",
    "sourceUrl": "Verified official download page. The archive URL, FDC ID and NDB number identify the source row. Old record-detail URL patterns were not used because they returned 404 during verification.",
    "unsatStatus": "calculated, missing, or source-inconsistent; null unsat must remain unknown during downstream aggregation.",
    "checkedAt": "Date the source archive and mapping were checked, not the laboratory measurement date."
  },
